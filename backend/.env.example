# Copy sang .env va sua lai
DATABASE_URL=postgres://shopfun:shopfun123@localhost:5433/shopfun
PORT=5000
# Secret JWT 32+ ky tu. Tao secret moi bang:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay-bang-secret-ngau-nhien-32-ky-tu-tro-len
# Domain frontend duoc phep goi API (phay neu nhieu). Cookie chi chay khi CORS cu the, khong dung '*'
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Cookie cross-site (frontend/backend khac domain, VD Vercel + Render):
# dat COOKIE_SAMESITE=none (can https o ca 2 dau). Cung site thi de mac dinh.
# COOKIE_SAMESITE=none
# VietQR nhan tien (de trong = chi COD). VD: MB / 0123456789 / NGUYEN VAN A
VIETQR_BANK=
VIETQR_ACCOUNT=
VIETQR_NAME=SHOPFUN
